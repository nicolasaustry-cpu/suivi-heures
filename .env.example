# ── Copier ce fichier en .env et remplir les valeurs ──

# Chaîne de connexion MongoDB Atlas
# Remplacer <username>, <password> et <cluster> par vos vraies valeurs
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/suivi-heures?retryWrites=true&w=majority

# Clé secrète JWT (générer une chaîne aléatoire longue)
JWT_SECRET=changez-cette-cle-par-une-vraie-cle-secrete-32-caracteres

# Identifiants de l'administrateur (VOUS)
ADMIN_EMAIL=votre@email.com
ADMIN_PASSWORD=VotreMotDePasseAdmin

# Port (laisser 3000 en local, Railway le définit automatiquement)
PORT=3000
